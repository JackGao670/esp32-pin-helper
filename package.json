{
  "name": "esp-pin-planner",
  "displayName": "ESP Pin Planner",
  "description": "Visual ESP32 pin planning without changing application source code.",
  "version": "0.0.3",
  "publisher": "local-development",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/JackGao670/esp32-pin-helper.git" },
  "homepage": "https://github.com/JackGao670/esp32-pin-helper#readme",
  "bugs": { "url": "https://github.com/JackGao670/esp32-pin-helper/issues" },
  "icon": "resources/icon.png",
  "keywords": ["esp32", "esp-idf", "pinout", "gpio", "hardware", "embedded", "peripheral", "camera", "lcd", "i2c", "spi", "uart"],
  "engines": { "vscode": "^1.90.0" },
  "categories": ["Other"],
  "galleryBanner": { "color": "#12308f", "theme": "dark" },
  "main": "./dist/extension.js",
  "activationEvents": ["onCommand:espPinPlanner.open", "onCommand:espPinPlanner.validate", "onCommand:espPinPlanner.create", "onCommand:espPinPlanner.selectTarget", "onCommand:espPinPlanner.fixWithAi", "onChatParticipant:espPinPlanner", "onView:espPinPlanner.home", "workspaceContains:**/.pinconfig.json", "onLanguage:json"],
  "contributes": {
    "chatParticipants": [
      {
        "id": "espPinPlanner",
        "name": "espPinPlanner",
        "fullName": "ESP Pin Planner",
        "description": "%chat.description%",
        "isSticky": true,
        "commands": [
          { "name": "generate", "description": "%chat.generate.description%" },
          { "name": "fix", "description": "%chat.fix.description%" }
        ]
      }
    ],
    "commands": [
      { "command": "espPinPlanner.open", "title": "%command.open.title%", "category": "ESP Pin Planner", "icon": "$(open-preview)" },
      { "command": "espPinPlanner.validate", "title": "%command.validate.title%", "category": "ESP Pin Planner", "icon": "$(check)" },
      { "command": "espPinPlanner.create", "title": "%command.create.title%", "category": "ESP Pin Planner", "icon": "$(new-file)" },
      { "command": "espPinPlanner.selectTarget", "title": "%command.selectTarget.title%", "category": "ESP Pin Planner", "icon": "$(circuit-board)" },
      { "command": "espPinPlanner.fixWithAi", "title": "%command.fixWithAi.title%", "category": "ESP Pin Planner", "icon": "$(sparkle)" }
    ],
    "viewsContainers": {
      "activitybar": [
        { "id": "espPinPlanner", "title": "ESP Pin Planner", "icon": "resources/pin-planner.svg" }
      ]
    },
    "views": {
      "espPinPlanner": [
        { "id": "espPinPlanner.home", "name": "%view.home.name%", "type": "webview" }
      ]
    },
    "menus": {
      "editor/title": [
        { "command": "espPinPlanner.open", "when": "resourceFilename == .pinconfig.json", "group": "navigation@1" }
      ],
      "editor/context": [
        { "command": "espPinPlanner.fixWithAi", "when": "resourceFilename == .pinconfig.json", "group": "espPinPlanner@1" }
      ],
      "view/title": [
        { "command": "espPinPlanner.validate", "when": "view == espPinPlanner.home", "group": "navigation@1" }
      ]
    },
    "jsonValidation": [{ "fileMatch": "**/.pinconfig.json", "url": "./schemas/pinconfig.schema.json" }],
    "configuration": {
      "title": "ESP Pin Planner",
      "properties": {
        "espPinPlanner.language": {
          "type": "string",
          "enum": ["auto", "en", "zh-cn"],
          "enumDescriptions": ["%config.language.enum.auto%", "%config.language.enum.en%", "%config.language.enum.zh-cn%"],
          "default": "auto",
          "description": "%config.language.description%"
        },
        "espPinPlanner.defaultTarget": {
          "type": "string",
          "enum": ["esp32s3", "esp32c6", "esp32p4"],
          "default": "esp32s3",
          "description": "%config.defaultTarget.description%"
        },
        "espPinPlanner.schemaStrictInstance": {
          "type": "boolean",
          "default": true,
          "description": "%config.schemaStrictInstance.description%"
        },
        "espPinPlanner.rmtChannelBank": {
          "type": "string",
          "enum": ["tx", "rx", "auto"],
          "default": "auto",
          "description": "%config.rmtChannelBank.description%"
        },
        "espPinPlanner.board.preset": {
          "type": "string",
          "enum": ["auto", "none", "byId"],
          "default": "auto",
          "description": "%config.board.preset.description%"
        },
        "espPinPlanner.board.vendor": {
          "type": "string",
          "default": "espressif",
          "description": "%config.board.vendor.description%"
        },
        "espPinPlanner.board.id": {
          "type": "string",
          "default": "esp32-s3-devkitc-1",
          "description": "%config.board.id.description%"
        }
      }
    }
  },
  "scripts": {
    "build": "npm run typecheck && npm run build:extension && npm run build:webview",
    "build:extension": "esbuild src/extension.ts --bundle --platform=node --format=cjs --main-fields=module,main --external:vscode --outfile=dist/extension.js",
    "build:webview": "vite build --config webview/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "dev:webview": "vite --config webview/vite.config.ts --host 127.0.0.1",
    "test": "tsx --test test/*.test.ts",
    "vscode:prepublish": "npm run build"
  },
  "dependencies": { "esp-device-pack": "file:packages/esp-device-pack", "jsonc-parser": "^3.3.1", "react": "^18.3.1", "react-dom": "^18.3.1", "zustand": "^4.5.5" },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/vscode": "~1.90.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.4.4"
  }
}

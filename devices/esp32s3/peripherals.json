        { "id": "pwdn",   "direction": "output", "routing": "gpio_matrix", "required": false, "description": "Sensor PWDN / power-down control output (active-high on OV2640/OV5640)." },
        { "id": "reset",  "direction": "output", "routing": "gpio_matrix", "required": false, "description": "Sensor RESETb / hardware reset output (active-low on OV2640/OV5640)." }

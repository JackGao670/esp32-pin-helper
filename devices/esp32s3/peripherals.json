  "scope": "UART full duplex, I2C, standard SPI master, LEDC channels, ADC1/ADC2, RMT channels and I2S master; no high-speed timing validation. RMT TX/RX direction is not enforced (S3 channels 0-3 are TX-only and 4-7 RX-only). ADC2 shares hardware with Wi-Fi. Camera (DVP, 8-bit) and LCD (RGB, up to 16-bit documented; 24-bit signal pins are reserved as optional) are modeled at the baseline GPIOMatrix routing level; signal integrity and pixel clock constraints are NOT yet validated. Sensor and panel reset/powerdown pins are declared so the planner can reserve them.",
  "peripherals": [
    {
      "type": "uart",
      "instances": [0, 1, 2],
      "signals": [
        { "id": "tx", "direction": "output", "routing": "gpio_matrix", "required": true },
        { "id": "rx", "direction": "input", "routing": "gpio_matrix", "required": true },
        { "id": "rts", "direction": "output", "routing": "gpio_matrix", "required": false },
        { "id": "cts", "direction": "input", "routing": "gpio_matrix", "required": false }
      ]
    },
    {
      "type": "i2c",
      "instances": [0, 1],
      "signals": [
        { "id": "sda", "direction": "bidirectional", "routing": "gpio_matrix", "required": true, "openDrain": true },
        { "id": "scl", "direction": "bidirectional", "routing": "gpio_matrix", "required": true, "openDrain": true }
      ]
    },
    {
      "type": "spi",

        { "id": "pclk",   "direction": "input",  "routing": "gpio_matrix", "required": true,  "description": "Sensor pixel clock input. Sampling edge (rising/falling) is not modeled at this stage." },
        { "id": "vsync",  "direction": "input",  "routing": "gpio_matrix", "required": true,  "description": "Vertical sync active-high frame delimiter input." },
        { "id": "href",   "direction": "input",  "routing": "gpio_matrix", "required": true,  "description": "Horizontal reference / valid-data window input." },
        { "id": "d0",     "direction": "input",  "routing": "gpio_matrix", "required": true,  "description": "8-bit parallel data bit 0 (baseline, DVP 8-bit mode)." },

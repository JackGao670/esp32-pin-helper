    "https://docs.espressif.com/projects/esp-idf/en/v5.4/esp32h2/api-reference/peripherals/rmt.html",
    "https://docs.espressif.com/projects/esp-idf/en/v5.4/esp32h2/api-reference/peripherals/i2s.html",
    "https://docs.espressif.com/projects/esp-idf/en/v5.4/esp32h2/api-reference/peripherals/usb_serial_jtag.html",
    "https://docs.espressif.com/projects/esp-idf/en/v5.4/esp32h2/api-reference/peripherals/twai.html"
  ],
  "scope": "Standard UART (2 controllers), HP I2C (2 controllers), standard SPI master (SPI2 only; SPI0/SPI1 drive the flash and are not exposed; plus the optional quad-mode WP = IO2 / HD = IO3 lines), LEDC channels (6 channels, low-speed only), ADC1 (single 5-channel unit, no ADC2), RMT channels, I2S master and TWAI. LP controllers are excluded. usb0 models the fixed USB Serial/JTAG pads (D- = GPIO26, D+ = GPIO27); the D+/D- pair must be routed together. The ESP32-H2 has no Wi-Fi, no USB OTG and no SDMMC host, so none of those are modelled. twai0 models the single TWAI (CAN) controller (TX/RX required, BUS-OFF/CLKOUT optional) routed through GPIOMatrix; an external transceiver is required. RMT channels 0-1 are TX-only and 2-3 are RX-only.",
  "peripherals": [
    { "type": "uart", "instances": [0, 1], "signals": [
      { "id": "tx", "direction": "output", "routing": "gpio_matrix", "required": true },
      { "id": "rx", "direction": "input", "routing": "gpio_matrix", "required": true },
      { "id": "rts", "direction": "output", "routing": "gpio_matrix", "required": false },
      { "id": "cts", "direction": "input", "routing": "gpio_matrix", "required": false }
    ] },
    { "type": "i2c", "instances": [0, 1], "signals": [
      { "id": "sda", "direction": "bidirectional", "routing": "gpio_matrix", "required": true, "openDrain": true },
      { "id": "scl", "direction": "bidirectional", "routing": "gpio_matrix", "required": true, "openDrain": true }
    ] },
    { "type": "spi", "instances": [2], "signals": [
      { "id": "mosi", "direction": "output", "routing": "gpio_matrix", "required": false },
      { "id": "miso", "direction": "input", "routing": "gpio_matrix", "required": false },
      { "id": "sclk", "direction": "output", "routing": "gpio_matrix", "required": true },
      { "id": "cs", "direction": "output", "routing": "gpio_matrix", "required": false },
      { "id": "wp", "direction": "output", "routing": "gpio_matrix", "required": false },
      { "id": "hd", "direction": "output", "routing": "gpio_matrix", "required": false }
    ] },
    { "type": "ledc", "instances": [0, 1, 2, 3, 4, 5], "signals": [
      { "id": "out", "direction": "output", "routing": "gpio_matrix", "required": true }
    ] },
    { "type": "adc", "instances": [1], "signals": [
      { "id": "in", "direction": "input", "routing": "analog", "required": true }
    ] },
    { "type": "rmt", "instances": [0, 1, 2, 3], "signals": [
      { "id": "sig", "direction": "bidirectional", "routing": "gpio_matrix", "required": true }
    ] },
    { "type": "i2s", "instances": [0], "signals": [
      { "id": "bclk", "direction": "output", "routing": "gpio_matrix", "required": true },
      { "id": "ws", "direction": "output", "routing": "gpio_matrix", "required": true },
      { "id": "dout", "direction": "output", "routing": "gpio_matrix", "required": false },
      { "id": "din", "direction": "input", "routing": "gpio_matrix", "required": false },
      { "id": "mclk", "direction": "output", "routing": "gpio_matrix", "required": false }
    ] },
    { "type": "usb", "instances": [0], "signals": [
      { "id": "dn", "direction": "bidirectional", "routing": "dedicated", "gpio": [26], "required": true, "description": "USB D- (USB Serial/JTAG PHY negative data line), fixed to GPIO26." },
      { "id": "dp", "direction": "bidirectional", "routing": "dedicated", "gpio": [27], "required": true, "description": "USB D+ (USB Serial/JTAG PHY positive data line), fixed to GPIO27." }
    ] },
    { "type": "twai", "instances": [0], "signals": [
      { "id": "tx", "direction": "output", "routing": "gpio_matrix", "required": true, "description": "TWAI transmit line to the external CAN transceiver (dominant bit = low)." },
      { "id": "rx", "direction": "input", "routing": "gpio_matrix", "required": true, "description": "TWAI receive line from the external CAN transceiver; the transceiver must loop TX back to RX." },
      { "id": "bus_off", "direction": "output", "routing": "gpio_matrix", "required": false, "description": "BUS-OFF status output (optional)." },
      { "id": "clkout", "direction": "output", "routing": "gpio_matrix", "required": false, "description": "TWAI bit-clock output for external use (optional)." }
    ] }
  ]
}

      { "id": "cs", "direction": "output", "routing": "gpio_matrix", "required": false },
      { "id": "wp", "direction": "output", "routing": "gpio_matrix", "required": false },
      { "id": "hd", "direction": "output", "routing": "gpio_matrix", "required": false }
    ] },
    { "type": "ledc", "instances": [0, 1, 2, 3, 4, 5], "signals": [
      { "id": "out", "direction": "output", "routing": "gpio_matrix", "required": true }
    ] },
    { "type": "adc", "instances": [1], "signals": [

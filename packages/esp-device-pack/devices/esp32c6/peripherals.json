    ] },
    { "type": "rmt", "instances": [0, 1, 2, 3], "signals": [
      { "id": "sig", "direction": "bidirectional", "routing": "gpio_matrix", "required": true }
    ] },
    { "type": "i2s", "instances": [0], "signals": [
      { "id": "bclk", "direction": "output", "routing": "gpio_matrix", "required": true },
      { "id": "ws", "direction": "output", "routing": "gpio_matrix", "required": true },
      { "id": "dout", "direction": "output", "routing": "gpio_matrix", "required": false },
      { "id": "din", "direction": "input", "routing": "gpio_matrix", "required": false },
      { "id": "mclk", "direction": "output", "routing": "gpio_matrix", "required": false }
    ] },
    { "type": "usb", "instances": [0], "signals": [
      { "id": "dn", "direction": "bidirectional", "routing": "dedicated", "gpio": [12], "required": true, "description": "USB D- (USB Serial/JTAG PHY negative data line), fixed to GPIO12." },
      { "id": "dp", "direction": "bidirectional", "routing": "dedicated", "gpio": [13], "required": true, "description": "USB D+ (USB Serial/JTAG PHY positive data line), fixed to GPIO13." }
    ] },
    { "type": "twai", "instances": [0, 1], "signals": [
      { "id": "tx", "direction": "output", "routing": "gpio_matrix", "required": true, "description": "TWAI transmit line to the external CAN transceiver (dominant bit = low)." },
      { "id": "rx", "direction": "input", "routing": "gpio_matrix", "required": true, "description": "TWAI receive line from the external CAN transceiver; the transceiver must loop TX back to RX." },
      { "id": "bus_off", "direction": "output", "routing": "gpio_matrix", "required": false, "description": "BUS-OFF status output (optional)." },
      { "id": "clkout", "direction": "output", "routing": "gpio_matrix", "required": false, "description": "TWAI bit-clock output for external use (optional)." }
    ] }
